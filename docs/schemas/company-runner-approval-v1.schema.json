{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Runner V1 approval package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "created_at", "agent", "task", "workflow_state", "requested_action", "reason", "affected_files_resources", "branch_pr", "external_effects", "risk_approval_class", "recommended_next_action", "evidence", "run_id", "dispatch_id"],
  "properties": {
    "schema_version": { "const": "1" },
    "request_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "agent": { "enum": ["Alex", "Nova", "Pixel", "Atlas"] },
    "task": { "type": "object", "additionalProperties": false, "required": ["id", "path", "fingerprint"], "properties": { "id": { "type": "string", "pattern": "^TASK-[0-9]+$" }, "path": { "type": "string", "minLength": 1 }, "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "workflow_state": { "enum": ["BACKLOG", "DEVELOPMENT", "READY_FOR_QA", "QA", "CHANGES_REQUIRED", "QA_RETEST", "READY_FOR_REVIEW", "REVIEW", "APPROVED", "COMPLETED", "BLOCKED"] },
    "requested_action": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "affected_files_resources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "branch_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "pr", "head"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "pr": { "type": ["integer", "null"], "minimum": 1 },
        "head": { "type": "string", "minLength": 1 }
      }
    },
    "external_effects": { "type": "array", "items": { "type": "string" } },
    "risk_approval_class": { "enum": ["YELLOW", "RED", "UNKNOWN"] },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "run_id": { "type": "string", "minLength": 1 },
    "dispatch_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
