{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Runner AgentResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "task_id",
    "role",
    "from_state",
    "outcome",
    "next_state",
    "summary",
    "evidence",
    "publication",
    "completion",
    "context_manifest_sha256"
  ],
  "properties": {
    "contract": { "const": "AgentResultV1" },
    "schema_version": { "const": "1" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
    "role": { "enum": ["Alex", "Nova", "Pixel", "Atlas"] },
    "from_state": {
      "enum": [
        "BACKLOG",
        "DEVELOPMENT",
        "READY_FOR_QA",
        "QA",
        "CHANGES_REQUIRED",
        "QA_RETEST",
        "READY_FOR_REVIEW",
        "REVIEW",
        "APPROVED",
        "BLOCKED"
      ]
    },
    "outcome": { "enum": ["completed", "blocked", "failed"] },
    "next_state": {
      "oneOf": [
        {
          "enum": [
            "DEVELOPMENT",
            "READY_FOR_QA",
            "QA",
            "CHANGES_REQUIRED",
            "QA_RETEST",
            "READY_FOR_REVIEW",
            "REVIEW",
            "APPROVED",
            "COMPLETED",
            "BLOCKED"
          ]
        },
        { "type": "null" }
      ]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "branch",
            "base_sha",
            "changed_paths",
            "commit_message",
            "pull_request"
          ],
          "properties": {
            "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
            "branch": { "type": "string", "minLength": 1 },
            "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "changed_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "commit_message": { "type": "string", "minLength": 1, "maxLength": 200 },
            "pull_request": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["base", "title", "body"],
                  "properties": {
                    "base": { "const": "main" },
                    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "body": { "type": "string", "minLength": 1, "maxLength": 10000 }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "issue",
            "pull_request",
            "branch",
            "head_sha",
            "merge_sha",
            "issue_state",
            "pull_request_state"
          ],
          "properties": {
            "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
            "issue": { "type": "integer", "minimum": 1 },
            "pull_request": { "type": "integer", "minimum": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "merge_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "issue_state": { "const": "CLOSED" },
            "pull_request_state": { "const": "MERGED" }
          }
        },
        { "type": "null" }
      ]
    },
    "context_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
